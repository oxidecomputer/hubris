Interface(
    name: "Pins",
    ops: {
        "set_dir": (
            args: {
                "pin": (type: "Gpio", recv: FromPrimitive("u8")),
                "dir": (type: "Direction", recv: FromPrimitive("u8")),
            },
            reply: Simple("()"),
            idempotent: true, 
        ),
        "set_pin": (
            args: {
                "pin": (type: "Gpio", recv: FromPrimitive("u8")),
            },
            reply: Simple("()"),
            idempotent: true, 
        ),
        "clear_pin": (
            args: {
                "pin": (type: "Gpio", recv: FromPrimitive("u8")),
            },
            reply: Simple("()"),
            idempotent: true, 
        ),
        "toggle_pin": (
            args: {
                "pin": (type: "Gpio", recv: FromPrimitive("u8")),
            },
            reply: Simple("()"),
            idempotent: true, 
        ),
        "read_pin": (
            args: {
                "pin": (type: "Gpio", recv: FromPrimitive("u8")),
            },
            reply: Simple((type: "Value", recv: FromPrimitive("u8"))),
            idempotent: true, 
        ),
    },
)
