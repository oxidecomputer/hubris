{
    "type": "addrmap",
    "addr_span_bytes": 8,
    "inst_name": "versal_flash_regs",
    "addr_offset": 0,
    "children": [
        {
            "type": "reg",
            "inst_name": "mux_ctrl",
            "addr_offset": 0,
            "regwidth": 32,
            "min_accesswidth": 32,
            "children": [
                {
                    "type": "field",
                    "inst_name": "request",
                    "lsb": 0,
                    "msb": 0,
                    "reset": 0,
                    "sw_access": "rw",
                    "se_onread": null,
                    "se_onwrite": null,
                    "desc": "Set to 1 to ask for the Versal's boot flash."
                },
                {
                    "type": "field",
                    "inst_name": "to_fpga",
                    "lsb": 1,
                    "msb": 1,
                    "reset": 0,
                    "sw_access": "rw",
                    "se_onread": null,
                    "se_onwrite": null,
                    "desc": "Debug. Set to 1 to point the mux at the FPGA regardless of what the\nsequencer or the Versal is doing. No interlock: with the Versal out of reset\nthis takes the flash away from it mid-boot or mid-read. For bring-up."
                },
                {
                    "type": "field",
                    "inst_name": "mux_en",
                    "lsb": 2,
                    "msb": 2,
                    "reset": 0,
                    "sw_access": "rw",
                    "se_onread": null,
                    "se_onwrite": null,
                    "desc": "Debug. Set to 1 to hold the mux enabled (mux_en_l low) whoever the select\npoints at. Without it the mux is enabled while the FPGA owns the flash and\nwhile the Versal is out of reset, and disabled otherwise."
                }
            ]
        },
        {
            "type": "reg",
            "inst_name": "mux_status",
            "addr_offset": 4,
            "regwidth": 32,
            "min_accesswidth": 32,
            "children": [
                {
                    "type": "field",
                    "inst_name": "granted",
                    "lsb": 0,
                    "msb": 0,
                    "reset": 0,
                    "sw_access": "r",
                    "se_onread": null,
                    "se_onwrite": null,
                    "desc": "Set when the FPGA actually owns the flash: the sequencer\nclaimed it, or the request was made and the sequencer is holding\nthe Versal in reset."
                },
                {
                    "type": "field",
                    "inst_name": "seq_owned",
                    "lsb": 1,
                    "msb": 1,
                    "reset": 0,
                    "sw_access": "r",
                    "se_onread": null,
                    "se_onwrite": null,
                    "desc": "Set while the sequencer itself is claiming the flash for\nthe FPGA, during the pre-boot measurement and after the Versal has\nbooted."
                },
                {
                    "type": "field",
                    "inst_name": "mux_sel",
                    "lsb": 2,
                    "msb": 2,
                    "reset": 1,
                    "sw_access": "r",
                    "se_onread": null,
                    "se_onwrite": null,
                    "desc": "Live readback of the mux select pin (From FPGA to the mux). 0 connects the\nFPGA to the flash, 1 the Versal"
                },
                {
                    "type": "field",
                    "inst_name": "mux_en_l",
                    "lsb": 3,
                    "msb": 3,
                    "reset": 1,
                    "sw_access": "r",
                    "se_onread": null,
                    "se_onwrite": null,
                    "desc": "Live readback of the mux enable pin, active low (From FPGA to the mux)"
                },
                {
                    "type": "field",
                    "inst_name": "versal_held_in_reset",
                    "lsb": 4,
                    "msb": 4,
                    "reset": 0,
                    "sw_access": "r",
                    "se_onread": null,
                    "se_onwrite": null,
                    "desc": "Live readback of whether the sequencer is holding the Versal\nin reset, i.e. whether a request would be granted."
                }
            ]
        }
    ]
}