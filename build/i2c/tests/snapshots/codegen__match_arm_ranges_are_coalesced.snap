    pub mod devices {
        #[allow(unused_imports)]
        use drv_i2c_api::{I2cDevice, Controller, PortIndex};
        #[allow(unused_imports)]
        use userlib::TaskId;

        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn device_by_index(
            task: TaskId,
            index: usize,
        ) -> Option<I2cDevice> {
            match index {0 => Some(
                    // device 0
                    I2cDevice::new(task,
                        Controller::I2C2,
                        PortIndex(0),
                        None,
                        0x48,
                    )),
1 => Some(
                    // device 1
                    I2cDevice::new(task,
                        Controller::I2C2,
                        PortIndex(0),
                        None,
                        0x49,
                    )),
2 => Some(
                    // device 2
                    I2cDevice::new(task,
                        Controller::I2C2,
                        PortIndex(0),
                        None,
                        0x4a,
                    )),
3 => Some(
                    // device 3
                    I2cDevice::new(task,
                        Controller::I2C3,
                        PortIndex(0),
                        None,
                        0x4b,
                    )),
4 => Some(
                    // device 4
                    I2cDevice::new(task,
                        Controller::I2C3,
                        PortIndex(0),
                        None,
                        0x4c,
                    )),
5 => Some(
                    // device 5
                    I2cDevice::new(task,
                        Controller::I2C2,
                        PortIndex(0),
                        None,
                        0x4d,
                    )),

                _ => None,
            }
        }

        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn lookup_controller(index: usize) -> Option<Controller> {
            match index {
                0..=2
                | 5..=5 => Some(Controller::I2C2),
                3..=4 => Some(Controller::I2C3),
                _ => None
            }
        }

        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn lookup_port(index: usize) -> Option<PortIndex> {
            match index {
                0..=5 => Some(PortIndex(0)),
                _ => None
            }
        }

