pub mod devices {
    #[allow(unused_imports)]
    use drv_i2c_api::{Controller, I2cDevice, PortIndex};
    #[allow(unused_imports)]
    use userlib::TaskId;

    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn device_by_index(task: TaskId, index: usize) -> Option<I2cDevice> {
        match index {
            0 => Some(
                // Temperature sensor
                I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0x48,
                    "U31",
                ),
            ),
            1 => Some(
                // FRU ID EEPROM
                I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0x50,
                    "U32",
                ),
            ),
            2 => Some(
                // PSU 0 EEPROM
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x50,
                    "PSU0/ID",
                ),
            ),
            3 => Some(
                // PSU 0 MCU
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x58,
                    "PSU0",
                ),
            ),
            4 => Some(
                // PSU 1 EEPROM
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x51,
                    "PSU1/ID",
                ),
            ),
            5 => Some(
                // PSU 1 MCU
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x59,
                    "PSU1",
                ),
            ),
            6 => Some(
                // PSU 2 EEPROM
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x52,
                    "PSU2/ID",
                ),
            ),
            7 => Some(
                // PSU 2 MCU
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x5a,
                    "PSU2",
                ),
            ),
            8 => Some(
                // PSU 3 EEPROM
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x53,
                    "PSU3/ID",
                ),
            ),
            9 => Some(
                // PSU 3 MCU
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x5b,
                    "PSU3",
                ),
            ),
            10 => Some(
                // PSU 4 EEPROM
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x54,
                    "PSU4/ID",
                ),
            ),
            11 => Some(
                // PSU 4 MCU
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x5c,
                    "PSU4",
                ),
            ),
            12 => Some(
                // PSU 5 EEPROM
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x55,
                    "PSU5/ID",
                ),
            ),
            13 => Some(
                // PSU 5 MCU
                I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x5d,
                    "PSU5",
                ),
            ),

            _ => None,
        }
    }

    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn lookup_controller(index: usize) -> Option<Controller> {
        match index {
            0..=1 => Some(Controller::I2C2),
            2..=13 => Some(Controller::I2C3),
            _ => None,
        }
    }

    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn lookup_port(index: usize) -> Option<PortIndex> {
        match index {
            0..=13 => Some(PortIndex(0)),
            _ => None,
        }
    }

    #[allow(dead_code)]
    pub fn at24csw080(task: TaskId) -> [I2cDevice; 1] {
        [
            // FRU ID EEPROM
            I2cDevice::new(
                task,
                Controller::I2C2,
                PortIndex(0),
                None,
                0x50,
                "U32",
            ),
        ]
    }

    #[allow(dead_code)]
    pub fn m24c02(task: TaskId) -> [I2cDevice; 6] {
        [
            // PSU 0 EEPROM
            I2cDevice::new(
                task,
                Controller::I2C3,
                PortIndex(0),
                None,
                0x50,
                "PSU0/ID",
            ),
            // PSU 1 EEPROM
            I2cDevice::new(
                task,
                Controller::I2C3,
                PortIndex(0),
                None,
                0x51,
                "PSU1/ID",
            ),
            // PSU 2 EEPROM
            I2cDevice::new(
                task,
                Controller::I2C3,
                PortIndex(0),
                None,
                0x52,
                "PSU2/ID",
            ),
            // PSU 3 EEPROM
            I2cDevice::new(
                task,
                Controller::I2C3,
                PortIndex(0),
                None,
                0x53,
                "PSU3/ID",
            ),
            // PSU 4 EEPROM
            I2cDevice::new(
                task,
                Controller::I2C3,
                PortIndex(0),
                None,
                0x54,
                "PSU4/ID",
            ),
            // PSU 5 EEPROM
            I2cDevice::new(
                task,
                Controller::I2C3,
                PortIndex(0),
                None,
                0x55,
                "PSU5/ID",
            ),
        ]
    }

