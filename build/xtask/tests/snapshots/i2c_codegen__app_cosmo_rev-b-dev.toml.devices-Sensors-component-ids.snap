    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn lookup_controller(index: usize) -> Option<Controller> {
        match index {
            0..=33 => Some(Controller::I2C1),
            34..=40 => Some(Controller::I2C2),
            41..=50 => Some(Controller::I2C3),
            51..=62 => Some(Controller::I2C4),
            _ => None,
        }
    }
    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn lookup_port(index: usize) -> Option<PortIndex> {
        match index {
            0..=62 => Some(PortIndex(0)),
            _ => None,
        }
    }
