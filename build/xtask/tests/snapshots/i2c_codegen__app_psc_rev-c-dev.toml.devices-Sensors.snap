pub mod devices {
    #[allow(unused_imports)]
    use drv_i2c_api::{Controller, I2cDevice, PortIndex};
    #[allow(unused_imports)]
    use userlib::TaskId;

    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn lookup_controller(index: usize) -> Option<Controller> {
        match index {
            0..=1 => Some(Controller::I2C2),
            2..=13 => Some(Controller::I2C3),
            _ => None,
        }
    }

    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn lookup_port(index: usize) -> Option<PortIndex> {
        match index {
            0..=13 => Some(PortIndex(0)),
            _ => None,
        }
    }

    #[allow(dead_code)]
    pub fn at24csw080(task: TaskId) -> [I2cDevice; 1] {
        [
            // FRU ID EEPROM
            I2cDevice::new(task, Controller::I2C2, PortIndex(0), None, 0x50),
        ]
    }

    #[allow(dead_code)]
    pub fn m24c02(task: TaskId) -> [I2cDevice; 6] {
        [
            // PSU 0 EEPROM
            I2cDevice::new(task, Controller::I2C3, PortIndex(0), None, 0x50),
            // PSU 1 EEPROM
            I2cDevice::new(task, Controller::I2C3, PortIndex(0), None, 0x51),
            // PSU 2 EEPROM
            I2cDevice::new(task, Controller::I2C3, PortIndex(0), None, 0x52),
            // PSU 3 EEPROM
            I2cDevice::new(task, Controller::I2C3, PortIndex(0), None, 0x53),
            // PSU 4 EEPROM
            I2cDevice::new(task, Controller::I2C3, PortIndex(0), None, 0x54),
            // PSU 5 EEPROM
            I2cDevice::new(task, Controller::I2C3, PortIndex(0), None, 0x55),
        ]
    }

