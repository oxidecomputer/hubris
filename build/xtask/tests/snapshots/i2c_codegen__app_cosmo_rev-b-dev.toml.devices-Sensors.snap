    use userlib::TaskId;

    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn device_by_index(task: TaskId, index: usize) -> Option<I2cDevice> {
        match index {
            0 => Some(
                // Front FPGA virtual mux
                I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x70,
                ),
            ),
            1 => Some(
                // U.2 Sharkfin A VPD
                I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                    0x50,
                ),
            ),
            2 => Some(
                // U.2 Sharkfin A hot swap controller
                I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                    0x38,
                ),
            ),
            3 => Some(
                // U.2 A NVMe Basic Management Command
