            // U.2 Sharkfin F VPD
            I2cDevice::new(
                task,
                Controller::I2C2,
                PortIndex(1),
                Some((drv_i2c_api::Mux::M2, drv_i2c_api::Segment::S2)),
                0x50,
            ),
            // U.2 Sharkfin G VPD
            I2cDevice::new(
                task,
                Controller::I2C2,
                PortIndex(1),
                Some((drv_i2c_api::Mux::M2, drv_i2c_api::Segment::S3)),
                0x50,
            ),
            // U.2 Sharkfin H VPD
            I2cDevice::new(
                task,
                Controller::I2C2,
                PortIndex(1),
                Some((drv_i2c_api::Mux::M2, drv_i2c_api::Segment::S4)),
                0x50,
