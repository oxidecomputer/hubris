pub mod devices {
    #[allow(unused_imports)]
    use drv_i2c_api::{Controller, I2cDevice, PortIndex};
    #[allow(unused_imports)]
    use userlib::TaskId;

    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn lookup_controller(index: usize) -> Option<Controller> {
        match index {
            0..=39 | 75..=76 => Some(Controller::I2C2),
            40..=50 | 59..=66 => Some(Controller::I2C3),
            51..=58 | 67..=74 => Some(Controller::I2C4),
            _ => None,
        }
    }

    #[allow(dead_code)]
    #[allow(clippy::match_single_binding)]
    pub fn lookup_port(index: usize) -> Option<PortIndex> {
        match index {
            37..=76 => Some(PortIndex(0)),
            0..=36 => Some(PortIndex(1)),
            _ => None,
        }
    }

    #[allow(dead_code)]
    pub fn adm127x(task: TaskId) -> [I2cDevice; 2] {
        [
            // Fan hot swap controller
            I2cDevice::new(task, Controller::I2C4, PortIndex(0), None, 0x10),
            // Sled hot swap controller
            I2cDevice::new(task, Controller::I2C4, PortIndex(0), None, 0x14),
        ]
    }

