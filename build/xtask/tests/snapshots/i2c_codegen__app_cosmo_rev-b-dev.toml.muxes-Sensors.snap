#[allow(dead_code)]
pub const NMUXEDBUSES: usize = 2;

use drv_stm32xx_i2c::I2cMux;

pub fn muxes() -> [I2cMux<'static>; 2] {
    use drv_i2c_api::{Controller, Mux, PortIndex};

    #[allow(unused_imports)]
    use drv_stm32xx_sys_api::{self as gpio_api, Alternate};

    [
        I2cMux {
            controller: Controller::I2C2,
            port: PortIndex(0),
            id: Mux::M1,
            driver: &drv_stm32xx_i2c::oximux16::Oximux16,
            nreset: Some(I2cGpio {
                gpio_pins: gpio_api::Port::H.pin(9),
            }),
            address: 0x70,
        },
        I2cMux {
            controller: Controller::I2C1,
            port: PortIndex(0),
            id: Mux::M1,
            driver: &drv_stm32xx_i2c::oximux16::Oximux16,
            nreset: Some(I2cGpio {
                gpio_pins: gpio_api::Port::B.pin(10),
            }),
            address: 0x70,
        },
    ]
}
