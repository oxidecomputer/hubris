                    0x73,
                )),
                #[doc = " Front IO LED driver (left)"]
                35 => Some(I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0xa,
                )),
                #[doc = " Front IO LED driver (right)"]
                36 => Some(I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0xb,
