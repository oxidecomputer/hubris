pub(crate) mod i2c_config {
    #[allow(dead_code)]
    pub const NCONTROLLERS: usize = 3;
    use drv_stm32xx_i2c::I2cController;
    pub fn controllers() -> [I2cController<'static>; NCONTROLLERS] {
        use drv_i2c_api::Controller;
        use drv_stm32xx_sys_api::Peripheral;
        [
            I2cController {
                controller: Controller::I2C3,
                peripheral: Peripheral::I2c3,
                notification: crate::notifications::I2C3_IRQ_MASK,
                registers: unsafe { &*device::I2C3::ptr() },
            },
            I2cController {
                controller: Controller::I2C4,
                peripheral: Peripheral::I2c4,
                notification: crate::notifications::I2C4_IRQ_MASK,
                registers: unsafe { &*device::I2C4::ptr() },
            },
            I2cController {
                controller: Controller::I2C2,
                peripheral: Peripheral::I2c2,
                notification: crate::notifications::I2C2_IRQ_MASK,
                registers: unsafe { &*device::I2C2::ptr() },
            },
        ]
    }
    #[allow(unused_imports)]
    use drv_stm32xx_i2c::{I2cGpio, I2cPins};
    pub fn pins() -> [I2cPins; 4] {
        use drv_i2c_api::{Controller, PortIndex};
        use drv_stm32xx_sys_api::{self as gpio_api, Alternate};
        [
            I2cPins {
                controller: Controller::I2C3,
                port: PortIndex(0),
                scl: gpio_api::Port::H.pin(7),
                sda: gpio_api::Port::H.pin(8),
                function: Alternate::AF4,
            },
            I2cPins {
                controller: Controller::I2C4,
                port: PortIndex(0),
                scl: gpio_api::Port::F.pin(14),
                sda: gpio_api::Port::F.pin(15),
                function: Alternate::AF4,
            },
            I2cPins {
                controller: Controller::I2C2,
                port: PortIndex(0),
                scl: gpio_api::Port::B.pin(10),
                sda: gpio_api::Port::B.pin(11),
                function: Alternate::AF4,
            },
            I2cPins {
                controller: Controller::I2C2,
                port: PortIndex(1),
                scl: gpio_api::Port::F.pin(1),
                sda: gpio_api::Port::F.pin(0),
                function: Alternate::AF4,
            },
        ]
    }
    pub mod ports {
        #[allow(dead_code)]
        pub const fn i2c1_b() -> drv_i2c_api::PortIndex {
            drv_i2c_api::PortIndex(0)
        }
        #[allow(dead_code)]
        pub const fn i2c3_h() -> drv_i2c_api::PortIndex {
            drv_i2c_api::PortIndex(0)
        }
        #[allow(dead_code)]
        pub const fn i2c4_f() -> drv_i2c_api::PortIndex {
            drv_i2c_api::PortIndex(0)
        }
        #[allow(dead_code)]
        pub const fn i2c2_b() -> drv_i2c_api::PortIndex {
            drv_i2c_api::PortIndex(0)
        }
        #[allow(dead_code)]
        pub const fn i2c2_f() -> drv_i2c_api::PortIndex {
            drv_i2c_api::PortIndex(1)
        }
    }
    #[allow(dead_code)]
    pub const NMUXEDBUSES: usize = 2;
    use drv_stm32xx_i2c::I2cMux;
    pub fn muxes() -> [I2cMux<'static>; 4] {
        use drv_i2c_api::{Controller, Mux, PortIndex};
        #[allow(unused_imports)]
        use drv_stm32xx_sys_api::{self as gpio_api, Alternate};
        [
            I2cMux {
                controller: Controller::I2C2,
                port: PortIndex(0),
                id: Mux::M1,
                driver: &drv_stm32xx_i2c::pca9545::Pca9545,
                nreset: Some(I2cGpio {
                    gpio_pins: gpio_api::Port::E.pin(15),
                }),
                address: 0x73,
            },
            I2cMux {
                controller: Controller::I2C2,
                port: PortIndex(1),
                id: Mux::M1,
                driver: &drv_stm32xx_i2c::pca9545::Pca9545,
                nreset: Some(I2cGpio {
                    gpio_pins: gpio_api::Port::E.pin(12),
                }),
                address: 0x70,
            },
            I2cMux {
                controller: Controller::I2C2,
                port: PortIndex(1),
                id: Mux::M2,
                driver: &drv_stm32xx_i2c::pca9545::Pca9545,
                nreset: Some(I2cGpio {
                    gpio_pins: gpio_api::Port::E.pin(14),
                }),
                address: 0x71,
            },
            I2cMux {
                controller: Controller::I2C2,
                port: PortIndex(1),
                id: Mux::M3,
                driver: &drv_stm32xx_i2c::pca9545::Pca9545,
                nreset: Some(I2cGpio {
                    gpio_pins: gpio_api::Port::E.pin(13),
                }),
                address: 0x72,
            },
        ]
    }
}
