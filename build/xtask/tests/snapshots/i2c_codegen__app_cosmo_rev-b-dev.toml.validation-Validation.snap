    pub mod validation {
        #[allow(unused_imports)]
        use drv_i2c_api::{I2cDevice, Controller, PortIndex};
        #[allow(unused_imports)]
        use drv_i2c_devices::Validate;
        use userlib::TaskId;

        #[allow(dead_code)]
        pub enum I2cValidation {
            RawReadOk,
            Good,
            Bad,
        }

        #[allow(unused_variables)]
        #[allow(clippy::match_single_binding)]
        pub fn validate(
            task: TaskId,
            index: usize,
        ) -> Result<I2cValidation, drv_i2c_api::ResponseCode> {
            match index {
                0 => {
                    // Front FPGA virtual mux
                    I2cDevice::new(task,
                        Controller::I2C1,
                        PortIndex(0),
                        None,
                        0x70,
                    ).read::<u8>()?;
                    Ok(I2cValidation::RawReadOk)
                }
                1 => {
                    if drv_i2c_devices::at24csw080::At24Csw080::validate(&
                        // U.2 Sharkfin A VPD
                        I2cDevice::new(task,
                            Controller::I2C1,
                            PortIndex(0),
                            Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                            0x50,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                2 => {
                    if drv_i2c_devices::max5970::Max5970::validate(&
                        // U.2 Sharkfin A hot swap controller
                        I2cDevice::new(task,
                            Controller::I2C1,
                            PortIndex(0),
                            Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                            0x38,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                3 => {
                    if drv_i2c_devices::nvme_bmc::NvmeBmc::validate(&
                        // U.2 A NVMe Basic Management Command
                        I2cDevice::new(task,
                            Controller::I2C1,
                            PortIndex(0),
                            Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                            0x6a,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                4 => {
                    if drv_i2c_devices::at24csw080::At24Csw080::validate(&
                        // U.2 Sharkfin B VPD
                        I2cDevice::new(task,
                            Controller::I2C1,
                            PortIndex(0),
                            Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S2)),
                            0x50,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                5 => {
                    if drv_i2c_devices::max5970::Max5970::validate(&
                        // U.2 Sharkfin B hot swap controller
                        I2cDevice::new(task,
                            Controller::I2C1,
                            PortIndex(0),
                            Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S2)),
                            0x38,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
