    pub mod validation {
        #[allow(unused_imports)]
        use drv_i2c_api::{I2cDevice, Controller, PortIndex};
        #[allow(unused_imports)]
        use drv_i2c_devices::Validate;
        use userlib::TaskId;

        #[allow(dead_code)]
        pub enum I2cValidation {
            RawReadOk,
            Good,
            Bad,
        }

        #[allow(unused_variables)]
        #[allow(clippy::match_single_binding)]
        pub fn validate(
            task: TaskId,
            index: usize,
        ) -> Result<I2cValidation, drv_i2c_api::ResponseCode> {
            match index {
                0 => {
                    // Temperature sensor
                    I2cDevice::new(task,
                        Controller::I2C2,
                        PortIndex(0),
                        None,
                        0x48,
                    ).read::<u8>()?;
                    Ok(I2cValidation::RawReadOk)
                }
                1 => {
                    if drv_i2c_devices::at24csw080::At24Csw080::validate(&
                        // FRU ID EEPROM
                        I2cDevice::new(task,
                            Controller::I2C2,
                            PortIndex(0),
                            None,
                            0x50,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                2 => {
                    if drv_i2c_devices::m24c02::M24C02::validate(&
                        // PSU 0 EEPROM
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x50,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                3 => {
                    if drv_i2c_devices::mwocp68::Mwocp68::validate(&
                        // PSU 0 MCU
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x58,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                4 => {
                    if drv_i2c_devices::m24c02::M24C02::validate(&
                        // PSU 1 EEPROM
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x51,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                5 => {
                    if drv_i2c_devices::mwocp68::Mwocp68::validate(&
                        // PSU 1 MCU
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x59,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                6 => {
                    if drv_i2c_devices::m24c02::M24C02::validate(&
                        // PSU 2 EEPROM
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x52,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                7 => {
                    if drv_i2c_devices::mwocp68::Mwocp68::validate(&
                        // PSU 2 MCU
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x5a,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                8 => {
                    if drv_i2c_devices::m24c02::M24C02::validate(&
                        // PSU 3 EEPROM
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x53,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                9 => {
                    if drv_i2c_devices::mwocp68::Mwocp68::validate(&
                        // PSU 3 MCU
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x5b,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                10 => {
                    if drv_i2c_devices::m24c02::M24C02::validate(&
                        // PSU 4 EEPROM
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x54,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                11 => {
                    if drv_i2c_devices::mwocp68::Mwocp68::validate(&
                        // PSU 4 MCU
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x5c,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                12 => {
                    if drv_i2c_devices::m24c02::M24C02::validate(&
                        // PSU 5 EEPROM
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x55,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                13 => {
                    if drv_i2c_devices::mwocp68::Mwocp68::validate(&
                        // PSU 5 MCU
                        I2cDevice::new(task,
                            Controller::I2C3,
                            PortIndex(0),
                            None,
                            0x5d,
                        ))? {
                        Ok(I2cValidation::Good)
                    } else {
                        Ok(I2cValidation::Bad)
                    }
                }
                _ => Err(drv_i2c_api::ResponseCode::BadArg)
            }
        }
    }
