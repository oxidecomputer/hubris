pub(crate) mod i2c_config {
    pub mod devices {
        #[allow(unused_imports)]
        use drv_i2c_api::{Controller, I2cDevice, PortIndex};
        #[allow(unused_imports)]
        use userlib::TaskId;
        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        #[allow(unused_doc_comments)]
        pub fn device_by_index(
            task: TaskId,
            index: usize,
        ) -> Option<I2cDevice> {
            match index {
                #[doc = " Temperature sensor"]
                0 => Some(I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0x48,
                )),
                #[doc = " FRU ID EEPROM"]
                1 => Some(I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0x50,
                )),
                #[doc = " PSU 0 EEPROM"]
                2 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x50,
                )),
                #[doc = " PSU 0 MCU"]
                3 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x58,
                )),
                #[doc = " PSU 1 EEPROM"]
                4 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x51,
                )),
                #[doc = " PSU 1 MCU"]
                5 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x59,
                )),
                #[doc = " PSU 2 EEPROM"]
                6 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x52,
                )),
                #[doc = " PSU 2 MCU"]
                7 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x5a,
                )),
                #[doc = " PSU 3 EEPROM"]
                8 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x53,
                )),
                #[doc = " PSU 3 MCU"]
                9 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x5b,
                )),
                #[doc = " PSU 4 EEPROM"]
                10 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x54,
                )),
                #[doc = " PSU 4 MCU"]
                11 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x5c,
                )),
                #[doc = " PSU 5 EEPROM"]
                12 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x55,
                )),
                #[doc = " PSU 5 MCU"]
                13 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x5d,
                )),
                _ => None,
            }
        }
        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn lookup_controller(index: usize) -> Option<Controller> {
            match index {
                0..=1 => Some(Controller::I2C2),
                2..=13 => Some(Controller::I2C3),
                _ => None,
            }
        }
        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn lookup_port(index: usize) -> Option<PortIndex> {
            match index {
                0..=13 => Some(PortIndex(0)),
                _ => None,
            }
        }
