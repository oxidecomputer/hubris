    pub mod devices {
        #[allow(unused_imports)]
        use drv_i2c_api::{I2cDevice, Controller, PortIndex};
        #[allow(unused_imports)]
        use userlib::TaskId;

        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn lookup_controller(index: usize) -> Option<Controller> {
            match index {
                0..=7
                | 29..=30 => Some(Controller::I2C1),
                33..=39 => Some(Controller::I2C2),
                8..=18
                | 31..=32 => Some(Controller::I2C3),
                19..=28 => Some(Controller::I2C4),
                _ => None
            }
        }

        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn lookup_port(index: usize) -> Option<PortIndex> {
            match index {
                0..=4
                | 8..=13
                | 28..=30
                | 33..=39 => Some(PortIndex(0)),
                5..=7
                | 14..=24
                | 31..=32 => Some(PortIndex(1)),
                25..=27 => Some(PortIndex(2)),
                _ => None
            }
        }

        #[allow(dead_code)]
        pub fn adm127x(task: TaskId) -> [I2cDevice; 5] {
            [
                // Fan 1 hot swap controller
                I2cDevice::new(task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x10,
                ),
                // Fan 0 hot swap controller
                I2cDevice::new(task,
                    Controller::I2C1,
                    PortIndex(1),
                    None,
                    0x13,
                ),
                // 54V hot swap controller
                I2cDevice::new(task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x16,
                ),
                // Fan 2 hot swap controller
                I2cDevice::new(task,
                    Controller::I2C3,
                    PortIndex(1),
                    None,
                    0x13,
                ),
                // Fan 3 hot swap controller
                I2cDevice::new(task,
                    Controller::I2C3,
                    PortIndex(1),
                    None,
                    0x10,
                ),
            ]
        }

        #[allow(dead_code)]
        pub fn at24csw080(task: TaskId) -> [I2cDevice; 6] {
            [
                // Mainboard FRUID
                I2cDevice::new(task,
                    Controller::I2C4,
                    PortIndex(0),
                    None,
                    0x50,
                ),
                // Fan 0 FRUID
                I2cDevice::new(task,
                    Controller::I2C1,
                    PortIndex(0),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S2)),
                    0x50,
                ),
                // Fan 1 FRUID
                I2cDevice::new(task,
                    Controller::I2C1,
                    PortIndex(0),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                    0x50,
                ),
                // Fan 2 FRUID
                I2cDevice::new(task,
                    Controller::I2C3,
                    PortIndex(1),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S2)),
                    0x50,
                ),
                // Fan 3 FRUID
                I2cDevice::new(task,
                    Controller::I2C3,
                    PortIndex(1),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                    0x50,
                ),
                // Front IO board FRUID
                I2cDevice::new(task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0x50,
                ),
            ]
        }

