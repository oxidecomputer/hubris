        pub fn device_by_index(
            task: TaskId,
            index: usize,
        ) -> Option<I2cDevice> {
            match index {
                #[doc = " Fan 1 hot swap controller"]
                0 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x10,
                )),
                #[doc = " Fan 0/1 controller"]
                1 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x23,
                )),
                #[doc = " North-northeast temperature sensor"]
                2 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x49,
                )),
                #[doc = " TF2 VDD rail"]
                3 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x63,
                )),
                #[doc = " Northeast fan mux"]
                4 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x70,
                )),
                #[doc = " Fan 0 hot swap controller"]
                5 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(1),
                    None,
                    0x13,
                )),
                #[doc = " V3P3_SYS rail"]
                6 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(1),
                    None,
                    0x1a,
                )),
                #[doc = " Northeast temperature sensor"]
                7 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(1),
                    None,
                    0x48,
                )),
                #[doc = " 54V hot swap controller"]
                8 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x16,
                )),
                #[doc = " V5P0_SYS rail"]
                9 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x19,
                )),
                #[doc = " North-northwest temperature sensor"]
                10 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x48,
                )),
                #[doc = " TF2 temperature sensor"]
                11 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x4c,
                )),
                #[doc = " TF2 VDDA rail"]
                12 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x60,
                )),
                #[doc = " Intermediate bus converter"]
                13 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(0),
                    None,
                    0x67,
                )),
                #[doc = " Fan 2 hot swap controller"]
                14 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(1),
                    None,
                    0x13,
                )),
                #[doc = " Fan 3 hot swap controller"]
                15 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(1),
                    None,
                    0x10,
                )),
                #[doc = " Northwest temperature sensor"]
                16 => Some(I2cDevice::new(
