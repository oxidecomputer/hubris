                #[doc = " Fan 0 FRUID"]
                29 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S2)),
                    0x50,
                )),
                #[doc = " Fan 1 FRUID"]
                30 => Some(I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                    0x50,
                )),
                #[doc = " Fan 2 FRUID"]
                31 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(1),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S2)),
                    0x50,
                )),
                #[doc = " Fan 3 FRUID"]
                32 => Some(I2cDevice::new(
                    task,
                    Controller::I2C3,
                    PortIndex(1),
                    Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
