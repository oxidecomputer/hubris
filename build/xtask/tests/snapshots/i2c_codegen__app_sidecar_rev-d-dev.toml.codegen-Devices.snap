                #[doc = " Front IO V3P3_SYS_A2 rail"]
                37 => Some(I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0x1b,
                )),
                #[doc = " Front IO V3P3_QSFP0_A0 rail"]
                38 => Some(I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0x19,
                )),
                #[doc = " Front IO V3P3_QSFP1_A0 rail"]
                39 => Some(I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(0),
                    None,
                    0x1a,
                )),
                _ => None,
            }
        }
        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn lookup_controller(index: usize) -> Option<Controller> {
            match index {
                0..=7 | 29..=30 => Some(Controller::I2C1),
                33..=39 => Some(Controller::I2C2),
                8..=18 | 31..=32 => Some(Controller::I2C3),
                19..=28 => Some(Controller::I2C4),
                _ => None,
            }
        }
        #[allow(dead_code)]
        #[allow(clippy::match_single_binding)]
        pub fn lookup_port(index: usize) -> Option<PortIndex> {
            match index {
                0..=4 | 8..=13 | 28..=30 | 33..=39 => Some(PortIndex(0)),
                5..=7 | 14..=24 | 31..=32 => Some(PortIndex(1)),
                25..=27 => Some(PortIndex(2)),
                _ => None,
            }
        }
