                        I2cDevice::new(task,
                            Controller::I2C2,
                            PortIndex(0),
                            None,
                            0xa,
                        ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            36 => {
                if drv_i2c_devices::pca9956b::Pca9956B::validate(
