pub mod validation {
    #[allow(unused_imports)]
    use drv_i2c_api::{Controller, I2cDevice, PortIndex};
    #[allow(unused_imports)]
    use drv_i2c_devices::Validate;
    use userlib::TaskId;
    #[allow(dead_code)]
    pub enum I2cValidation {
        RawReadOk,
        Good,
        Bad,
    }
    #[allow(unused_variables)]
    #[allow(clippy::match_single_binding)]
    #[allow(unused_doc_comments)]
    pub fn validate(
        task: TaskId,
        index: usize,
    ) -> Result<I2cValidation, drv_i2c_api::ResponseCode> {
        match index {
            #[doc = " Fan 1 hot swap controller"]
            0 => {
                if drv_i2c_devices::adm127x::Adm127X::validate(
                    &I2cDevice::new(
                        task,
                        Controller::I2C1,
                        PortIndex(0),
                        None,
                        0x10,
                    ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " Fan 0/1 controller"]
            1 => {
                if drv_i2c_devices::max31790::Max31790::validate(
                    &I2cDevice::new(
                        task,
                        Controller::I2C1,
                        PortIndex(0),
                        None,
                        0x23,
                    ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " North-northeast temperature sensor"]
            2 => {
                if drv_i2c_devices::tmp117::Tmp117::validate(&I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x49,
                ))? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " TF2 VDD rail"]
            3 => {
                if drv_i2c_devices::raa229618::Raa229618::validate(
                    &I2cDevice::new(
                        task,
                        Controller::I2C1,
                        PortIndex(0),
                        None,
                        0x63,
                    ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " Northeast fan mux"]
            4 => {
                I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(0),
                    None,
                    0x70,
                )
                .read::<u8>()?;
                Ok(I2cValidation::RawReadOk)
            }
            #[doc = " Fan 0 hot swap controller"]
            5 => {
                if drv_i2c_devices::adm127x::Adm127X::validate(
                    &I2cDevice::new(
                        task,
                        Controller::I2C1,
                        PortIndex(1),
                        None,
                        0x13,
                    ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " V3P3_SYS rail"]
            6 => {
                if drv_i2c_devices::tps546b24a::Tps546B24A::validate(
                    &I2cDevice::new(
                        task,
                        Controller::I2C1,
                        PortIndex(1),
                        None,
                        0x1a,
                    ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " Northeast temperature sensor"]
            7 => {
                if drv_i2c_devices::tmp117::Tmp117::validate(&I2cDevice::new(
                    task,
                    Controller::I2C1,
                    PortIndex(1),
                    None,
                    0x48,
                ))? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
