pub mod validation {
    #[allow(unused_imports)]
    use drv_i2c_api::{Controller, I2cDevice, PortIndex};
    #[allow(unused_imports)]
    use drv_i2c_devices::Validate;
    use userlib::TaskId;
    #[allow(dead_code)]
    pub enum I2cValidation {
        RawReadOk,
        Good,
        Bad,
    }
    #[allow(unused_variables)]
    #[allow(clippy::match_single_binding)]
    #[allow(unused_doc_comments)]
    pub fn validate(
        task: TaskId,
        index: usize,
    ) -> Result<I2cValidation, drv_i2c_api::ResponseCode> {
        match index {
            #[doc = " Southwest temperature sensor"]
            0 => {
                if drv_i2c_devices::tmp117::Tmp117::validate(&I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(1),
                    None,
                    0x48,
                ))? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " South temperature sensor"]
            1 => {
                if drv_i2c_devices::tmp117::Tmp117::validate(&I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(1),
                    None,
                    0x49,
                ))? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " Southeast temperature sensor"]
            2 => {
                if drv_i2c_devices::tmp117::Tmp117::validate(&I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(1),
                    None,
                    0x4a,
                ))? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " U.2 ABCD mux"]
            3 => {
                I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(1),
                    None,
                    0x70,
                )
                .read::<u8>()?;
                Ok(I2cValidation::RawReadOk)
            }
            #[doc = " U.2 EFGH mux"]
            4 => {
                I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(1),
                    None,
                    0x71,
                )
                .read::<u8>()?;
                Ok(I2cValidation::RawReadOk)
            }
            #[doc = " U.2 IJ/FRUID mux"]
            5 => {
                I2cDevice::new(
                    task,
                    Controller::I2C2,
                    PortIndex(1),
                    None,
                    0x72,
                )
                .read::<u8>()?;
                Ok(I2cValidation::RawReadOk)
            }
            #[doc = " U.2 Sharkfin A VPD"]
            6 => {
                if drv_i2c_devices::at24csw080::At24Csw080::validate(
                    &I2cDevice::new(
                        task,
                        Controller::I2C2,
                        PortIndex(1),
                        Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                        0x50,
                    ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " U.2 Sharkfin A hot swap controller"]
            7 => {
                if drv_i2c_devices::max5970::Max5970::validate(
                    &I2cDevice::new(
                        task,
                        Controller::I2C2,
                        PortIndex(1),
                        Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                        0x38,
                    ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " U.2 A NVMe Basic Management Command"]
            8 => {
                if drv_i2c_devices::nvme_bmc::NvmeBmc::validate(
                    &I2cDevice::new(
                        task,
                        Controller::I2C2,
                        PortIndex(1),
                        Some((drv_i2c_api::Mux::M1, drv_i2c_api::Segment::S1)),
                        0x6a,
                    ),
                )? {
                    Ok(I2cValidation::Good)
                } else {
                    Ok(I2cValidation::Bad)
                }
            }
            #[doc = " U.2 Sharkfin B VPD"]
            9 => {
                if drv_i2c_devices::at24csw080::At24Csw080::validate(
                    &I2cDevice::new(
                        task,
